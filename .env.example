# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Web App Config (Optional for production sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=street-norai-moda
VITE_FIREBASE_STORAGE_BUCKET=street-norai-moda.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Config
PORT=5001
NODE_ENV=production
ALLOWED_ORIGINS=https://street.norai.moda

# Required only when running server.js outside Firebase Functions.
# Point this to a Firebase service-account JSON file; never commit that file.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
