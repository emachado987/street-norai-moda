rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Compatibilidad temporal con el editor del probador virtual que comparte proyecto.
    function canManageSharedProject() {
      return isAdmin()
        || (request.auth != null && request.auth.uid == 'K10ca6Z1hfSSTrhCck1hrp1EWR83');
    }

    function isValidStreetHistory() {
      return request.resource.data.keys().hasAll([
          'image', 'resultImage', 'prompt', 'headline', 'copy', 'engine', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'image', 'resultImage', 'prompt', 'headline', 'copy', 'engine', 'createdAt'
        ])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 2048
        && request.resource.data.resultImage is string
        && request.resource.data.resultImage.size() <= 2048
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() <= 1000
        && request.resource.data.headline is string
        && request.resource.data.headline.size() <= 120
        && request.resource.data.copy is string
        && request.resource.data.copy.size() <= 3000
        && request.resource.data.engine in ['gemini', 'openai', 'demo']
        && request.resource.data.createdAt is int;
    }

    match /street_history/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidStreetHistory();
      allow delete: if isAdmin();
    }

    match /{collection}/{document=**} {
      allow read: if true;
      allow write: if collection != 'street_history' && canManageSharedProject();
    }
  }
}
